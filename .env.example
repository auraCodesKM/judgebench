# cp .env.example .env   (.env is gitignored). Used via: uv run --env-file .env judgebench ...
DATABASE_URL=postgresql+psycopg://judgebench:judgebench@localhost:5432/judgebench
# Google Workspace (M0 item 4)
GOOGLE_CLIENT_SECRETS_FILE=.secrets/oauth_client.json
GOOGLE_TOKEN_FILE=.secrets/google.token.json
# Telegram (item 5). The chat ID goes in events/<slug>.yaml, not here.
TELEGRAM_BOT_TOKEN=
# GitHub fine-grained, public repos read-only (item 6)
GITHUB_TOKEN=
# Model mode. offline (default): mock agents + lexical embedder, zero model calls, $0; every result
# is labelled MOCK. vertex: real Gemini + embeddings via ADC (item 7). Vertex calls are BILLED.
LLM_MODE=offline
# Vertex AI via ADC (item 7), used only when LLM_MODE=vertex
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash
# Probe: "inprocess" for local dev (same guarded client); on Cloud Run the jb-probe service URL
PROBE_URL=inprocess
# Pub/Sub (M2): empty = local mode (worker polls the DB)
PUBSUB_TOPIC=
EMBEDDING_MODEL=gemini-embedding-001
TELEGRAM_WEBHOOK_SECRET=
